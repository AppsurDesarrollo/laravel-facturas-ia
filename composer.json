{
    "name": "appsur/laravel-facturas-ia",
    "description": "Extracción de facturas españolas en PDF con IA (OpenAI) y guardado estructurado (proveedor, receptor, factura, albaranes, líneas) para cualquier proyecto Laravel.",
    "keywords": ["laravel", "facturas", "invoices", "openai", "ia", "ocr", "extraccion", "spain"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Kike (emarino-appsur)",
            "homepage": "https://github.com/emarino-appsur",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Appsur\\FacturasIa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appsur\\FacturasIa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Appsur\\FacturasIa\\FacturasIaServiceProvider"
            ],
            "aliases": {
                "FacturasIa": "Appsur\\FacturasIa\\Facades\\FacturasIa"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
