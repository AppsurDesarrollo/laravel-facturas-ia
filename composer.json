{
    "name": "appsur/laravel-facturas-ia",
    "description": "Extracción de facturas españolas en PDF con IA (OpenAI) y guardado estructurado (proveedor, receptor, factura, albaranes, líneas) para cualquier proyecto Laravel.",
    "keywords": ["laravel", "facturas", "invoices", "openai", "ia", "ocr", "extraccion", "spain"],
    "license": "proprietary",
    "authors": [
        { "name": "AppsurDesarrollo" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Appsur\\FacturasIa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appsur\\FacturasIa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Appsur\\FacturasIa\\FacturasIaServiceProvider"
            ],
            "aliases": {
                "FacturasIa": "Appsur\\FacturasIa\\Facades\\FacturasIa"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/testbench package:test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
